ے سامنے شفاعت کرسکے، وہ جانتا ہے جو ان کے سامنے ہے اور جو ان کے پیچھے ہے اور وہ اس کے علم میں سے کسی چیز کا احاطہ نہیں کرسکتے مگر جتنا وہ چاہے، اس کی کرسی کی وسعت نے زمین و آسمان کو گھیر رکھا ہے اور اللہ تعالیٰ ان کی حفاظت سے نہ تھکتا اور نہ اکتاتا ہے، وہ تو بہت بلند اور بہت بڑا ہے"},"words":[{"ar":"وَسِعَ","g":{"en":"Extends over","ur":"سمائے ہوئے ہے"},"w":["w:wasia"],"given":false,"say":"wasiʿa","pic":"img:art/wasia.webp"},{"ar":"كُرْسِيُّهُ","g":{"en":"His Kursi","ur":"اس کی کرسی"},"w":["w:kursi","w:hu"],"given":false,"say":"kursiyyuhu","medal":"كُرْسِيّ"},{"ar":"ٱلسَّمَـٰوَٰتِ","g":{"en":"the heavens","ur":"آسمانوں"},"w":["w:al","w:sama"],"given":false,"say":"as-samāwāti","pic":"img:art/sama.webp"},{"ar":"وَٱلْأَرْضَ","mark":"ۖ","g":{"en":"and the earth,","ur":"اور زمین کو"},"w":["w:wa","w:al","w:ard"],"given":false,"say":"wal-arḍa","pic":"img:art/ard.webp"},{"ar":"وَلَا","g":{"en":"and does not","ur":"اور نہیں"},"w":["w:wa","w:la"],"given":false,"say":"walā","pic":"img:art/la.webp"},{"ar":"يَـُٔودُهُۥ","g":{"en":"tire Him","ur":"اسے تھکاتی"},"w":["w:yaudu","w:hu"],"given":false,"say":"yaʾūduhū","pic":"img:art/yaudu.webp","pieces":[{"ar":"يَئُودُ","g":{"en":"weighs down, tires","ur":"تھکاتا ہے"}},{"ar":"ـهُ","g":{"en":"Him","ur":"اسے"}}]},{"ar":"حِفْظُهُمَا","mark":"ۚ","g":{"en":"guarding them both.","ur":"ان دونوں کی حفاظت"},"w":["w:hifz","w:huma_end"],"given":false,"say":"ḥifẓuhumā","pic":"img:art/hifz.webp"},{"ar":"وَهُوَ","g":{"en":"And He is","ur":"اور وہ"},"w":["w:wa","w:huwa"],"given":false,"say":"wahuwa","pic":"img:art/huwa.webp"},{"ar":"ٱلْعَلِىُّ","g":{"en":"the Most High,","ur":"سب سے بلند"},"w":["w:al","w:ali"],"given":false,"say":"al-ʿaliyyu","medal":"عَلِيّ"},{"ar":"ٱلْعَظِيمُ","g":{"en":"the Most Great.","ur":"بہت عظمت والا ہے"},"w":["w:al","w:azim"],"given":false,"say":"al-ʿaẓīmu","pic":"img:art/azim.webp","medal":"الْعَظِيم"}],"part":[41,50],"end":true},{"type":"passage","whole":"ayah","title":{"ar":"آيَةُ الْكُرْسِيّ","en":"Ayat al-Kursi (the V