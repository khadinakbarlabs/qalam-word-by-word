سے کسی چیز کا احاطہ نہیں کرسکتے مگر جتنا وہ چاہے، اس کی کرسی کی وسعت نے زمین و آسمان کو گھیر رکھا ہے اور اللہ تعالیٰ ان کی حفاظت سے نہ تھکتا اور نہ اکتاتا ہے، وہ تو بہت بلند اور بہت بڑا ہے"},"words":[{"ar":"وَهُوَ","g":{"en":"And He is","ur":"اور وہ"},"w":["w:wa","w:huwa"],"given":false,"say":"wahuwa","pic":"img:art/huwa.webp"},{"ar":"ٱلْعَلِىُّ","g":{"en":"the Most High,","ur":"سب سے بلند"},"w":["w:al","w:ali"],"given":false,"say":"al-ʿaliyyu","medal":"عَلِيّ"},{"ar":"ٱلْعَظِيمُ","g":{"en":"the Most Great.","ur":"بہت عظمت والا ہے"},"w":["w:al","w:azim"],"given":false,"say":"al-ʿaẓīmu","pic":"img:art/azim.webp","medal":"الْعَظِيم"}],"part":[48,50],"end":true}]}]}
